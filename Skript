# Import kasutajad.csv failist AD-sse
# CSV päised peavad olema: Nimi,Osakond

Import-Module ActiveDirectory

$DomainDN = "DC=ekristal,DC=local"
$CsvPath = "C:\Users\Administrator\Desktop\kasutajad.csv"
$BaseOU = "Kasutajad"
$DefaultPassword = ConvertTo-SecureString "Passw0rd" -AsPlainText -Force

# Loo põhi-OU Kasutajad, kui seda pole
if (-not (Get-ADOrganizationalUnit -Filter "Name -eq '$BaseOU'" -ErrorAction SilentlyContinue)) {
    New-ADOrganizationalUnit -Name $BaseOU -Path $DomainDN
}

$BaseOUPath = "OU=$BaseOU,$DomainDN"

$users = Import-Csv -Path $CsvPath -Delimiter ","

foreach ($user in $users) {
    $FullName = $user.Nimi.Trim()
    $Department = $user.Osakond.Trim()

    $DepartmentOUPath = "OU=$Department,$BaseOUPath"

    # Loo osakonna OU, kui seda pole
    if (-not (Get-ADOrganizationalUnit -LDAPFilter "(ou=$Department)" -SearchBase $BaseOUPath -ErrorAction SilentlyContinue)) {
        New-ADOrganizationalUnit -Name $Department -Path $BaseOUPath
    }

    # Kasutajanimi kujul eesnimi.perenimi
    $parts = $FullName.Split(" ")
    $FirstName = $parts[0]
    $LastName = $parts[-1]
    $Username = ($FirstName + "." + $LastName).ToLower()

    # Täpitähtede asendamine kasutajanimes
    $Username = $Username `
        -replace "ä","a" `
        -replace "ö","o" `
        -replace "ü","u" `
        -replace "õ","o"

    # Kui kasutaja on juba olemas, jäta vahele
    if (Get-ADUser -Filter "SamAccountName -eq '$Username'" -ErrorAction SilentlyContinue) {
        Write-Host "Kasutaja $Username on juba olemas, jätan vahele."
        continue
    }

    New-ADUser `
        -Name $FullName `
        -GivenName $FirstName `
        -Surname $LastName `
        -SamAccountName $Username `
        -UserPrincipalName "$Username@ekristal.local" `
        -Department $Department `
        -Path $DepartmentOUPath `
        -AccountPassword $DefaultPassword `
        -Enabled $true `
        -ChangePasswordAtLogon $true

    Write-Host "Loodud kasutaja: $Username OU-s $Department"
}

