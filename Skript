Import-Module ActiveDirectory

# CSV faili asukoht
$csvPath = "C:\Users\Administrator\kasutajad.csv"

# Domeeni DN
$domainDN = "DC=ekristal,DC=local"

# Põhi-OU, mille alla osakonnad luuakse
$rootOU = "Kasutajad"
$rootOUPath = "OU=$rootOU,$domainDN"

# Vaikimisi parool kõigile loodavatele kasutajatele
$defaultPassword = "Passw0rd"

# Kontrollime, kas CSV fail on olemas
if (-not (Test-Path $csvPath)) {
    Write-Host "VIGA: CSV faili ei leitud asukohast $csvPath" -ForegroundColor Red
    exit
}

# Kontrollime, kas põhi-OU Kasutajad on olemas
$existingRootOU = Get-ADOrganizationalUnit `
    -Filter { Name -eq $rootOU } `
    -SearchBase $domainDN `
    -SearchScope OneLevel `
    -ErrorAction SilentlyContinue

if (-not $existingRootOU) {
    New-ADOrganizationalUnit `
        -Name $rootOU `
        -Path $domainDN

    Write-Host "Loodud põhi-OU: $rootOU" -ForegroundColor Green
}
else {
    Write-Host "Põhi-OU on juba olemas: $rootOU" -ForegroundColor Yellow
}

# Impordime kasutajad CSV failist
$users = Import-Csv -Path $csvPath

foreach ($user in $users) {

    # Loeme CSV-st täisnime ja osakonna
    $fullName = $user.Nimi.Trim()
    $department = $user.Osakond.Trim()

    # Kontrollime, et nimi ja osakond ei oleks tühjad
    if ([string]::IsNullOrWhiteSpace($fullName) -or [string]::IsNullOrWhiteSpace($department)) {
        Write-Host "Vigane rida CSV failis, jäeti vahele." -ForegroundColor Red
        continue
    }

    # Osakonna OU asukoht
    $departmentOUPath = "OU=$department,$rootOUPath"

    # Kontrollime, kas osakonna OU on juba olemas
    $existingDepartmentOU = Get-ADOrganizationalUnit `
        -Filter { Name -eq $department } `
        -SearchBase $rootOUPath `
        -SearchScope OneLevel `
        -ErrorAction SilentlyContinue

    if (-not $existingDepartmentOU) {
        New-ADOrganizationalUnit `
            -Name $department `
            -Path $rootOUPath

        Write-Host "Loodud osakonna OU: $department" -ForegroundColor Green
    }
    else {
        Write-Host "Osakonna OU on juba olemas: $department" -ForegroundColor Yellow
    }

    # Jagame täisnime osadeks
    $nameParts = $fullName.Split(" ", [System.StringSplitOptions]::RemoveEmptyEntries)

    # Eesnimeks võtame esimese nimeosa
    $firstName = $nameParts[0]

    # Perenimeks võtame viimase nimeosa
    $lastName = $nameParts[-1]

    # Kasutajanimi kujul eesnimi.perenimi
    $username = "$firstName.$lastName".ToLower()

    # Eemaldame kasutajanimest Eesti täpitähed
    $username = $username `
        -replace "ä", "a" `
        -replace "ö", "o" `
        -replace "ü", "u" `
        -replace "õ", "o"

    # Kontrollime, kas kasutaja on juba olemas
    $existingUser = Get-ADUser `
        -Filter { SamAccountName -eq $username } `
        -ErrorAction SilentlyContinue

    if (-not $existingUser) {

        New-ADUser `
            -Name $fullName `
            -GivenName $firstName `
            -Surname $lastName `
            -SamAccountName $username `
            -UserPrincipalName "$username@ekristal.local" `
            -Path $departmentOUPath `
            -AccountPassword (ConvertTo-SecureString $defaultPassword -AsPlainText -Force) `
            -Enabled $true `
            -ChangePasswordAtLogon $false

        Write-Host "Loodud kasutaja: $fullName ($username) OU-s $department" -ForegroundColor Green
    }
    else {
        Write-Host "Kasutaja on juba olemas: $username" -ForegroundColor Yellow
    }
}





Kui CSV fail kasutab semikoolonit

Kui CSV fail on kujul:

Nimi;Osakond
Aivo Teder;Müük
Andres Karl Kukk;Personal

siis tuleb muuta skriptis see rida:

$users = Import-Csv -Path $csvPath

selliseks:

$users = Import-Csv -Path $csvPath -Delimiter ";"

Kui CSV fail on komaga eraldatud, siis seda muudatust ei ole vaja teha.

Skripti käivitamine

Ava PowerShell administraatori õigustes.

Seejärel luba skriptide käivitamine:

Set-ExecutionPolicy RemoteSigned -Force

Käivita skript:

C:\Temp\import-kasutajad.ps1

Kui skript on mõnes teises kaustas, kasuta vastavat asukohta, näiteks:

C:\Users\Administrator\import-kasutajad.ps1
Kontrollimine
1. Kontrolli, kas põhi-OU Kasutajad on olemas
Get-ADOrganizationalUnit `
    -Filter * `
    -SearchBase "DC=ekristal,DC=local" `
    -SearchScope OneLevel |
Select-Object Name, DistinguishedName

Oodatav tulemus:

Kasutajad
2. Kontrolli, kas osakondade OU-d loodi Kasutajad OU alla
Get-ADOrganizationalUnit `
    -Filter * `
    -SearchBase "OU=Kasutajad,DC=ekristal,DC=local" |
Select-Object Name, DistinguishedName

Oodatav tulemus on näiteks:

Müük
Personal
Raamatupidamine
Toimetajad
IT
Juhtkond
Haldus
3. Kontrolli, kas kasutajad loodi
Get-ADUser `
    -Filter * `
    -SearchBase "OU=Kasutajad,DC=ekristal,DC=local" |
Select-Object Name, SamAccountName, DistinguishedName
4. Kontrolli ühe osakonna kasutajaid

Näiteks Müük osakonna kontroll:

Get-ADUser `
    -Filter * `
    -SearchBase "OU=Müük,OU=Kasutajad,DC=ekristal,DC=local" |
Select-Object Name, SamAccountName
